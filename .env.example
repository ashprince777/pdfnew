# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Accounts and Premium switch on automatically once these are set; without them
# the site runs as a free tool site with no login and no limits.

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.pdfadore.com
# Shown on Contact / Terms / Refund pages (Razorpay checks these):
NEXT_PUBLIC_SUPPORT_EMAIL=support@pdfadore.com
NEXT_PUBLIC_LEGAL_NAME=Foxora Digital LLP
NEXT_PUBLIC_BUSINESS_ADDRESS=Kozhikode (Calicut), Kerala, India
NEXT_PUBLIC_JURISDICTION=Kozhikode, Kerala
NEXT_PUBLIC_SUPPORT_PHONE=+91 98097 25430

# --- Supabase (Project Settings → API) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Secret! Server only. Used by the payment webhook and account deletion.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Razorpay (Dashboard → Account & Settings → API Keys) ---------------------------
# Use rzp_test_... keys until Razorpay activates your account, then switch to rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Secret! Server only.
RAZORPAY_KEY_SECRET=xxxxxxxx
# Plan IDs from Dashboard → Subscriptions → Plans (must match prices in lib/plans.ts)
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxx
# The secret you type when creating the webhook (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- AI tools: Summarize, Chat with PDF, Translate (console.groq.com → API Keys) -------
# Secret! Server only. AI tools also need the Supabase variables above (credits are per account).
# Leave empty to show "AI coming soon" on the AI pages.
GROQ_API_KEY=
# Optional: model (default openai/gpt-oss-120b) and the longest document text per request
# (default 20000 characters, sized for Groq's free tier; raise it on a paid Groq tier).
# GROQ_MODEL=openai/gpt-oss-120b
# AI_MAX_TEXT_CHARS=20000

# --- Optional -------------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Emails allowed to open the /admin dashboard (comma-separated)
# ADMIN_EMAILS=you@example.com
